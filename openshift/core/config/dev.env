# Environment overrides for DEV.
APPNAME=bdc-data-portal-cohort-builder-service
ENV=dev
VERSION_NUM=0-1-0

# ARO Project
NAMESPACE=

IMAGE_REGISTRY_URL=nonprodnhlbi.azurecr.io
REGISTRY_SECRET=nonprodacr-secret
REGISTRY_NAMESPACE=

ROUTE_SUFFIX=apps.nonprodaro.nhlbi.nih.gov

RUN_AS_USER_ID=1000940000

REPLICA_COUNT=1
CONTAINER_PORT=8080
APP_EXPOSED_PORT=8080

APP_LOG_LEVEL=DEBUG
CPU_REQUEST=100m
CPU_LIMIT=1
MEMORY_REQUEST=512Mi
MEMORY_LIMIT=1536Mi
