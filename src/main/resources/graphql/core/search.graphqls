extend type Query {
  """
  Unfiltered page-load snapshot: all parent participant documents in the configured index.
  """
  searchProbe: SearchProbeResult!
}

type SearchProbeResult {
  snapshot: CohortSnapshot!
  status: String!
  backend: String!
  httpStatus: Int!
  elapsedMillis: Int!
  """Exact number of matching index documents, as a string to preserve integer precision. Not a distinct-person or cohort count."""
  totalHits: String!
}

extend type Query {
  """Supply keyword or keywords. OR within PRESENT keys and within ABSENT keys; AND between the two groups. ABSENT requires an explicit record. Interim snapshot, not SummaryResponse."""
  searchConditions(keyword: String, keywords: [String!]): SearchCountResult!
}

type ConditionCount {
  """Exact status|relationship|concept keyword, not a display label."""
  conditionKey: String!
  """Matching parent documents with this keyword. Buckets may overlap."""
  documentCount: String!
}

type SearchCountResult {
  snapshot: CohortSnapshot!
  keyword: String
  keywords: [String!]!
  """Exact matching parent-document count."""
  totalHits: String!
  buckets: [ConditionCount!]!
  """Sum of bucket document counts omitted by the top-100 limit, not distinct participants."""
  sumOtherDocCount: String!
  """Elasticsearch's upper bound on bucket count error for this terms aggregation."""
  docCountErrorUpperBound: String!
}

"""Interim right-hand snapshot. Null means unavailable, never zero. Not summary.yaml's SummaryResponse."""
type CohortSnapshot {
  """Exact matching parent-document count; participant count assumes one document per participant."""
  participantCount: Count!
  """All parent participant documents in the configured index, ignoring selected condition filters."""
  totalParticipantCount: Count!
  studyCount: Count
  totalStudyCount: Count
  datasetCount: Count
  totalDatasetCount: Count
  indexRelease: String
  lastUpdated: String
  unavailableFields: [String!]!
}
