"""Whole validated summary object, using the same snake_case field names as the typed API."""
scalar JSON
"""Nonnegative integral count, serialized as a JSON number; not limited to GraphQL Int's 32 bits."""
scalar Count
"""Decimal boundary serialized as a JSON number without conversion to a Java double."""
scalar Decimal

extend type Query {
  """Select concept summary sections. Includes use OR; exclusions hide matching sections. Counts and demographics retain their original population. No new cohort is calculated."""
  summary(sourceId: ID! = "t2d", include: [ID!]! = [], exclude: [ID!]! = []): SummaryResponse
  """The same validated summary as a JSON value."""
  summaryJson(sourceId: ID! = "t2d", include: [ID!]! = [], exclude: [ID!]! = []): JSON
  """Available precomputed summary source IDs."""
  summarySources: [ID!]!
  """The selected source's term catalog; presence does not imply a disease-positive count."""
  summaryConcepts(sourceId: ID! = "t2d"): [SummaryTerm!]
}

enum SummarizedSlot { sex race ethnicity age_at_index }
enum RelationSource { KG CURATED }

type SummaryResponse {
  release: String!
  seed: ID!
  """Original summary IDs defining the population counted. Not arbitrary concept selections."""
  filter: [String!]!
  min_count: Count!
  terms: [SummaryTerm!]!
  relations: [TermRelation!]!
  research_studies: [ResearchStudy!]!
  studies: [StudySummary!]!
}

type SummaryTerm {
  curie: ID!
  label: String
  vocabulary: String
  parents: [String!]!
}

type TermRelation {
  subject: ID!
  predicate: String!
  object: ID!
  relation_source: RelationSource!
}

type ResearchStudy {
  id: ID!
  name: String
  research_project_type: String
  program: String
  principal_investigator: [String!]!
}

type StudySummary {
  research_study: ID!
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Aggregate age-at-index bins."""
  participants: [ParticipantSummary!]!
  demographics: [DemographySummary!]!
  conditions: [ConditionSummary!]!
  procedures: [ProcedureSummary!]!
  drug_exposures: [DrugExposureSummary!]!
  measurements: [MeasurementObservationSummary!]!
}

type ParticipantSummary {
  id: ID!
  summarized_slot: SummarizedSlot!
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Lower bin bound, inclusive. Null means open-ended."""
  bin_low: Decimal
  """Upper bin bound, exclusive. Null means open-ended."""
  bin_high: Decimal
  bin_unit: String
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ParticipantSummary!]!
}

type DemographySummary {
  id: ID!
  summarized_slot: SummarizedSlot!
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  sex: String
  race: [String!]!
  ethnicity: String
  values: [DemographySummary!]!
}

type ConditionSummary {
  id: ID!
  condition_concept: ID
  condition_status: String
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ConditionSummary!]!
}

type ProcedureSummary {
  id: ID!
  procedure_concept: ID
  procedure_status: String
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ProcedureSummary!]!
}

type DrugExposureSummary {
  id: ID!
  drug_concept: ID
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [DrugExposureSummary!]!
}

type MeasurementObservationSummary {
  id: ID!
  observation_type: String
  """Estimated participants matching the source filter; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Lower bin bound, inclusive. Null means open-ended."""
  bin_low: Decimal
  """Upper bin bound, exclusive. Null means open-ended."""
  bin_high: Decimal
  bin_unit: String
  """Laboratory reference-range lower bound. This is not a bin boundary."""
  range_low: Decimal
  """Laboratory reference-range upper bound. This is not a bin boundary."""
  range_high: Decimal
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [MeasurementObservationSummary!]!
}
