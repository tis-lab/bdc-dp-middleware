"""Nonnegative integral count, serialized as a JSON number; not limited to GraphQL Int's 32 bits."""
scalar Count
"""Decimal boundary serialized as a JSON number without conversion to a Java double."""
scalar Decimal

extend type Query {
  """Live study-first summary. Omit filter (or pass null) for unfiltered page load."""
  summary(filter: SummaryFilterInput): SummaryResponse
}

"""Middleware-only request expression: exactly one non-null field per node. Maximum 8 levels / 100 nodes.
AND/OR lists must be nonempty. Use condition for concept-based UI selections; summaryId remains supported.
"""
input SummaryFilterInput {
  condition: SummaryConditionInput
  summaryId: ID
  and: [SummaryFilterInput!]
  or: [SummaryFilterInput!]
}

"""
Exact CURIE match against Elasticsearch condition.condition_concept.
The concept is matched as supplied; no ontology expansion or cross-class lookup.
EXCLUDE means an explicit ABSENT record, never a missing record or Boolean NOT.
"""
input SummaryConditionInput {
  concept: ID!
  selection: SummaryConditionSelection
  status: SummaryConditionStatus
  relationship: SummaryConditionRelationship = ONESELF
}
enum SummaryConditionSelection { INCLUDE EXCLUDE }
enum SummaryConditionStatus { PRESENT ABSENT }
enum SummaryConditionRelationship {
  ONESELF NATURAL_PARENT NATURAL_FATHER NATURAL_MOTHER NATURAL_SIBLING
  NATURAL_BROTHER NATURAL_SISTER NATURAL_CHILD BLOOD_RELATIVE
}

enum SummarizedSlot { sex race ethnicity age_at_index }
enum RelationSource { KG CURATED }

type SummaryResponse {
  release: String!
  seed: ID
  """Summary IDs required in every branch. Does not serialize the full AND/OR request; retain that request client-side."""
  filter: [String!]!
  min_count: Count!
  terms: [SummaryTerm!]!
  relations: [TermRelation!]!
  research_studies: [ResearchStudy!]!
  studies: [StudySummary!]!
}

type SummaryTerm {
  curie: ID!
  label: String
  vocabulary: String
  parents: [String!]!
}

type TermRelation {
  subject: ID!
  predicate: String!
  object: ID!
  relation_source: RelationSource!
}

type ResearchStudy {
  id: ID!
  name: String
  research_project_type: String
  program: String
  principal_investigator: [String!]!
}

type StudySummary {
  research_study: ID!
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Aggregate age-at-index bins."""
  participants: [ParticipantSummary!]!
  demographics: [DemographySummary!]!
  conditions: [ConditionSummary!]!
  procedures: [ProcedureSummary!]!
  drug_exposures: [DrugExposureSummary!]!
  measurements: [MeasurementObservationSummary!]!
}

type ParticipantSummary {
  id: ID!
  summarized_slot: SummarizedSlot!
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Lower bin bound, inclusive. Null means open-ended."""
  bin_low: Decimal
  """Upper bin bound, exclusive. Null means open-ended."""
  bin_high: Decimal
  bin_unit: String
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ParticipantSummary!]!
}

type DemographySummary {
  id: ID!
  summarized_slot: SummarizedSlot!
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  sex: String
  race: [String!]!
  ethnicity: String
  values: [DemographySummary!]!
}

type ConditionSummary {
  id: ID!
  condition_concept: ID
  condition_status: String
  relationship_to_participant: String
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ConditionSummary!]!
}

type ProcedureSummary {
  id: ID!
  procedure_concept: ID
  procedure_status: String
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [ProcedureSummary!]!
}

type DrugExposureSummary {
  id: ID!
  drug_concept: ID
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [DrugExposureSummary!]!
}

type MeasurementObservationSummary {
  id: ID!
  observation_type: String
  """Estimated participants matching the executed selection; recorded values include UNKNOWN."""
  participant_count: Count!
  """Optional aggregate number of observations, not a list of observations."""
  record_count: Count
  """Lower bin bound, inclusive. Null means open-ended."""
  bin_low: Decimal
  """Upper bin bound, exclusive. Null means open-ended."""
  bin_high: Decimal
  bin_unit: String
  """Laboratory reference-range lower bound. This is not a bin boundary."""
  range_low: Decimal
  """Laboratory reference-range upper bound. This is not a bin boundary."""
  range_high: Decimal
  """Recursive breakdown of this summary. Omitted small cells are not zero."""
  values: [MeasurementObservationSummary!]!
}
